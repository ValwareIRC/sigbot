# local tooling
/.claude/
/.playwright-mcp/

# Prism: the gadgets are part of the project; the rest of .prism (notes, decisions) is not
/.prism/*
!/.prism/gadgets/
# a gadget's local/ folder holds add-ons that stay on this machine
/.prism/gadgets/*/local/

node_modules/

# the server code the sims run on is its own project: clone it here (see README)
/sig-server/

# old copies of the userscripts from before the repo layout (the current ones are in userscript/)
/*.user.js

*.log

# one-off scripts from the swarm work of 2026-11-12: they stay on this machine
/tools/patch-*.mjs
/tools/cert-check*.mjs
/tools/live-*.mjs
/tools/headless-test.mjs
/tools/peek-bots.mjs
/tools/runner-live-check.mjs
/tools/verify-pipe.mjs
/tools/watch-one-bot.mjs
/tools/ws-gate-test.mjs
